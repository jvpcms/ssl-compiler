type intArray = array [30] of integer

function bSort(a: intArray, n: integer): intArray
{
  var i: integer;
  i = 0;
  while (i < n) {
    var j: integer;
    j = i + 1;
    while (j < n) {
      var troca: boolean;
      troca = a[i] > a[j];
      if (troca) {
        var v: integer;
        v = a[i];
        a[i] = a[j];
        a[j] = v;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return a;
}
