function strcmp(s1: string, n1: integer, s2: string, n2: integer): integer
{
  var i: integer;
  i = 0;
  while (i < n1 && i < n2 && s1[i] == s2[i])
    i = i + 1;
  if (i < n1 && i < n2) {
    var r: integer;
    if (s1[i] < s2[i]) r = -1; else r = 1;
    return r;
  }
  if (n1 < n2) return -1;
  if (n1 > n2) return 1;
  return 0;
}
